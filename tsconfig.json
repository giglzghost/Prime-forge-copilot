{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,

    // INTERNAL CODE ONLY
    "rootDir": "src",
    "outDir": "dist",

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/core/*": ["src/core/*"],
      "@/utils/*": ["src/utils/*"],
      "@/swarm/*": ["src/swarm/*"],
      "@/api/*": ["src/api/*"]   // internal API logic, NOT external endpoints
    }
  },

  // ONLY compile internal TypeScript
  "include": ["src/**/*"],

  // DO NOT compile external API endpoints
  "exclude": ["node_modules", "dist", "api"]
}
