{
  "version": 2,
  "builds": [
    { "src": "api/chat.ts", "use": "@vercel/node" },
    { "src": "api/llm.ts", "use": "@vercel/node" },
    { "src": "api/multi.ts", "use": "@vercel/node" },
    { "src": "api/image.ts", "use": "@vercel/node" },
    { "src": "api/status.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/chat", "dest": "/api/chat.ts" },
    { "src": "/api/llm", "dest": "/api/llm.ts" },
    { "src": "/api/multi", "dest": "/api/multi.ts" },
    { "src": "/api/image", "dest": "/api/image.ts" },
    { "src": "/api/status", "dest": "/api/status.ts" }
  ]
}
